# Copy this file to .env and fill in real values. Never commit the real .env file.

# NCBI / PubMed Entrez (https://www.ncbi.nlm.nih.gov/account/)
# Email identifying your requests to the Entrez API (required by NCBI usage policy).
NCBI_EMAIL=your.email@example.com
# API key from your NCBI account (raises the Entrez rate limit from 3 to 10 req/s).
NCBI_API_KEY=

# Google Gemini API (https://aistudio.google.com/app/apikey)
# Used by dags/scripts/llm_processor.py (literature relation extraction) and
# dags/scripts/synthesis_llm.py (cluster semantic synthesis).
GEMINI_API_KEY=

# Neo4j (knowledge graph database, provisioned by docker-compose.yml)
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
